{
  "name": "capi-relay",
  "version": "1.0.0",
  "description": "LAN-wide CAPI relay: routes Copilot side-channel completions to local LM Studio",
  "main": "capi-relay.js",
  "scripts": {
    "start":         "node capi-relay.js",
    "start:os":      "node run.js start",
    "install:os":    "node run.js install",
    "test":          "node test/verify.js",
    "test:title":    "node test/verify.js --discriminator title --timeout 60000",
    "test:compaction":"node test/verify.js --discriminator compaction --timeout 120000",
    "test:watch":    "node test/watch.js",
    "status":        "node test/status.js"
  },
  "license": "MIT",
  "dependencies": {}
}
